# Copy this file to .env and adjust as needed. All values are optional.

# Timezone shown in logs / used by the container.
TZ=UTC

# Fixed encryption key for API keys stored in the database (recommended for
# production). If unset, a random key is generated on first run and saved to
# /data/secret.key inside the volume - back that file up, or every stored API
# key becomes unrecoverable if the container/volume is lost.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HC_APP_SECRET_KEY=

# How often (seconds) services are polled by default. Can be overridden per
# service in the Settings tab. Default: 300 (5 minutes).
HC_DEFAULT_POLL_INTERVAL_SECONDS=300

# HTTP request timeout for checks, in seconds.
HC_HTTP_TIMEOUT_SECONDS=10

# How many days of check history to retain before it's pruned.
HC_HISTORY_RETENTION_DAYS=30

# Optional HTTP Basic Auth for the whole web UI/API. Leave both unset to
# disable auth (fine if the container isn't exposed beyond a trusted LAN).
HC_AUTH_USERNAME=
HC_AUTH_PASSWORD=

HC_LOG_LEVEL=INFO
